generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum rol_usuario {
  CLIENTE
  ADMIN
}

enum estado_pedido {
  PENDIENTE
  CONFIRMADO
  EN_PREPARACION
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum tipo_entrega {
  DOMICILIO
  RECOGER
}

model categoria {
  id_categoria Int        @id @default(autoincrement())
  nombre       String     @db.VarChar(100)
  producto     producto[]
}

model direccion {
  id_direccion Int      @id @default(autoincrement())
  fecha        DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  lugar        String   @db.VarChar(255)
  id_usuario   Int
  usuario      usuario  @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction, map: "fk_direccion_usuario")
  pedido       pedido[]
}

model foto_producto {
  id_foto     Int      @id @default(autoincrement())
  url         String   @db.VarChar(255)
  id_producto Int
  producto    producto @relation(fields: [id_producto], references: [id_producto], onDelete: Cascade, onUpdate: NoAction, map: "fk_foto_producto")
}

model pedido {
  id_pedido          Int               @id @default(autoincrement())
  codigo_seguimiento String            @unique @default(uuid()) @db.VarChar(36)

  id_usuario         Int?
  id_direccion       Int?

  nombre_cliente     String            @db.VarChar(100)
  telefono_cliente   String            @db.VarChar(20)
  correo_cliente     String?           @db.VarChar(150)

  tipo_entrega       tipo_entrega      @default(DOMICILIO)
  direccion_entrega  String?           @db.VarChar(255)
  notas              String?           @db.VarChar(255)

  estado             estado_pedido     @default(PENDIENTE)
  total              Decimal           @db.Decimal(10, 2)
  fecha              DateTime          @default(now()) @db.Timestamp(6)

  direccion          direccion?        @relation(fields: [id_direccion], references: [id_direccion], onDelete: SetNull, onUpdate: NoAction, map: "fk_pedido_direccion")
  usuario            usuario?          @relation(fields: [id_usuario], references: [id_usuario], onDelete: SetNull, onUpdate: NoAction, map: "fk_pedido_usuario")
  pedido_producto    pedido_producto[]

  @@index([id_usuario])
  @@index([estado])
}

model pedido_producto {
  id_detalleped   Int      @id @default(autoincrement())
  id_pedido       Int
  id_producto     Int
  cantidad        Int
  nota            String?  @db.VarChar(255)
  precio_unitario Decimal  @db.Decimal(10, 2)
  pedido          pedido   @relation(fields: [id_pedido], references: [id_pedido], onDelete: Cascade, onUpdate: NoAction, map: "fk_detalle_pedido")
  producto        producto @relation(fields: [id_producto], references: [id_producto], onUpdate: NoAction, map: "fk_detalle_producto")
}

model producto {
  id_producto     Int               @id @default(autoincrement())
  nombre          String            @db.VarChar(150)
  precio          Decimal           @db.Decimal(10, 2)
  descripcion     String?
  id_categoria    Int
    activo          Boolean           @default(true)
  foto_producto   foto_producto[]
  pedido_producto pedido_producto[]
  categoria       categoria         @relation(fields: [id_categoria], references: [id_categoria], onUpdate: NoAction, map: "fk_producto_categoria")
}

model usuario {
  id_usuario Int         @id @default(autoincrement())
  nombre     String      @db.VarChar(100)
  password   String      @db.VarChar(255)
  correo     String      @unique @db.VarChar(150)
  foto       String?     @db.VarChar(255)
  telefono   String?     @db.VarChar(20)
    rol        rol_usuario @default(CLIENTE)
  direccion  direccion[]
  pedido     pedido[]
}